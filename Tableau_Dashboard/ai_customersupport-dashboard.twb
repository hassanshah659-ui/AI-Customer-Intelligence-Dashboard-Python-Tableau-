      <aliases enabled='yes' />
      <column caption='Open Ticket' datatype='integer' name='[Calculation_0491212645912578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Ticket Status]=&quot;Open&quot; THEN 1 END' />
      </column>
      <column caption='Closed ' datatype='integer' name='[Calculation_0491212646014979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Ticket Status]=&quot;Closed&quot; THEN -1 END' />
      </column>
      <column caption='Radar Angle' datatype='real' name='[Calculation_0491212656451588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()*2*PI()/SIZE()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Radar X' datatype='real' name='[Calculation_0491212656533509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Has_CSAT]) * COS([Angle])' />
      </column>
      <column caption='Operational EFFICENCY' datatype='real' name='[Calculation_0491212656709638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Has_CSAT])/COUNT([Ticket ID])' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_0491212669542408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Angle Radial' datatype='real' name='[Calculation_0491212669616137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(INDEX()-1) * (360 / SIZE())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Radial X' datatype='real' name='[Calculation_0491212669988874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(INDEX()-1) * (360 / SIZE())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Radial Y' datatype='real' name='[Calculation_0491212670050315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(INDEX()-1) * (360 / SIZE())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Closed Tickets ' datatype='integer' name='[Calculation_0491212672581644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Ticket Status] = &quot;Closed&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Total Tickets 1' datatype='integer' name='[Calculation_0491212672720909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Remaining ' datatype='real' name='[Calculation_0491212673150991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_1188850732404736]' />
      </column>
      <column caption='Resolution Rate %' datatype='real' name='[Calculation_1188850732404736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Is_Resolved]) * 100' />
      </column>
      <column caption='Min(1)' datatype='integer' name='[Calculation_1281760009879552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Xcalculation ' datatype='real' name='[Calculation_1437891614892033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIN(RADIANS([Ticket ID]))' />
      </column>
      <column caption='Ycalculation' datatype='real' name='[Calculation_1437891615342594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COS(RADIANS([Ticket ID]))' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1437891629842435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Create Angle ' datatype='real' name='[Calculation_1437891629916164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(INDEX()-1) * (360/3)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='XCoordinate ' datatype='real' name='[Calculation_1437891629993989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COS(RADIANS([Calculation_1437891629916164])) * SUM([Ticket ID])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
